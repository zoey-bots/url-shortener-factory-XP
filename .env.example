# Example configuration ONLY.
#
# This file is NOT loaded automatically: the application reads real process
# environment variables. Copy these names into your shell/profile manager and
# set real values there before starting uvicorn. Never commit real secrets.

# Public base used to build short_url values (no trailing slash required).
BASE_URL=http://localhost:8000

# SQLite file path. Relative paths are resolved from the process CWD.
DATABASE_PATH=./links.db

# Comma-separated API keys. Trimmed; empty entries ignored. An empty value
# fails closed, so every /api/* request is rejected.
API_KEYS=replace-with-a-long-random-key,replace-with-an-optional-second-key
